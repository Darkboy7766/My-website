RewriteEngine On
RewriteBase /

# Изключва LiteSpeed page cache (LSCache) за целия сайт.
# Причина: LSCache кешираше старите .htaccess редиректи/canonical адреси и
# новите правила по-долу не се отразяваха веднага след деплой (виж GSC
# индексиращите проблеми, коригирани 2026-08-25). Сайтът е статичен Astro
# build с mod_expires за асетите, така че губим малко от page-level кеша,
# но печелим сигурност, че всяка промяна е видима веднага.
<IfModule LiteSpeed>
    CacheLookup off
</IfModule>

# 0. Консолидация на домейна – всичко към https://autogas-varna.com (без www, без http)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.autogas-varna\.com$ [NC]
RewriteRule ^(.*)$ https://autogas-varna.com/$1 [R=301,L]

# 1. СТАРИТЕ РЕДИРЕКТИ (Към новите малки букви, с крайна наклонена черта)
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^price\.html$ /tseni-gazov-inzhekcion/ [R=301,L,NC]
RewriteRule ^gallery\.html$ /galeriya/ [R=301,L,NC]
RewriteRule ^contact\.html$ /kontakti/ [R=301,L,NC]

# 1b. Стари адреси от React SPA / по-стари версии на сайта, без .html
RewriteRule ^agu_ceni\.html$ /tseni-gazov-inzhekcion/ [R=301,L,NC]
RewriteRule ^prices/?$ /tseni-gazov-inzhekcion/ [R=301,L,NC]
RewriteRule ^contact/?$ /kontakti/ [R=301,L,NC]
RewriteRule ^gallery/?$ /galeriya/ [R=301,L,NC]
RewriteRule ^services/aeb/?$ /gazov-inzhekcion-aeb/ [R=301,L,NC]
RewriteRule ^services/brc/?$ /gazov-inzhekcion-brc/ [R=301,L,NC]
RewriteRule ^services/prins/?$ /gazov-inzhekcion-prins/ [R=301,L,NC]

# Активиране на Gzip компресия
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Кеширане на ресурси (за 100% Performance)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# Astro е статичен build — всяка страница си има собствен реален HTML файл,
# затова вече НЕ пренасочваме всичко към index.html (React Router SPA fallback).
# Липсващ файл връща истинска 404 (виж 404.html).
ErrorDocument 404 /404.html
