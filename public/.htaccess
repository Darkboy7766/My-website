RewriteEngine On
RewriteBase /

# 1. СТАРИТЕ РЕДИРЕКТИ (Към новите малки букви)
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^price\.html$ /tseni-gazov-inzhekcion [R=301,L,NC]
RewriteRule ^gallery\.html$ /galeriya [R=301,L,NC]
RewriteRule ^contact\.html$ /kontakti [R=301,L,NC]

# Активиране на Gzip компресия
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Кеширане на ресурси (за 100% Performance)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# Astro е статичен build — всяка страница си има собствен реален HTML файл,
# затова вече НЕ пренасочваме всичко към index.html (React Router SPA fallback).
# Липсващ файл връща истинска 404 (виж 404.html).
ErrorDocument 404 /404.html
